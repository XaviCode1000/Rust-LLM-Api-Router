{
  "$schema": "https://qwen-code.com/settings.json",
  "mcpServers": {
    "github": {
      "type": "remote",
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "httpUrl": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "tools": {
    "github_*": true,
    "context7_*": true,
    "skill": true,
    "mem_*": true,
    "task": true,
    "web_search": true,
    "web_fetch": true,
    "read_file": true,
    "write_file": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "run_shell_command": true,
    "lsp": true
  },
  "permission": {
    "external_directory": {
      "./src/**": "allow",
      "./tests/**": "allow"
    }
  },
  "instructions": [
    "This project uses Agent Teams Lite (SDD) workflow",
    "For Rust code, ALWAYS load rust-skills before writing/reviewing code",
    "For research tasks, delegate to @rust-researcher",
    "For API design with Axum/Actix, use @rust-api",
    "For project structure, use @rust-project",
    "For code review, use @rust-reviewer",
    "For testing, use @rust-tester",
    "For SDD workflow coordination, use @sdd-orchestrator or /sdd-* commands",
    "Use Engram for persistent memory across sessions"
  ],
  "model": {
    "maxSessionTurns": -1,
    "chatCompression": {
      "contextPercentageThreshold": 0.7
    }
  },
  "general": {
    "enableAutoUpdate": true,
    "gitCoAuthor": true
  },
  "$version": 3
}