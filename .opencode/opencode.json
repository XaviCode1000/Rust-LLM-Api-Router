{
  "$schema": "https://opencode.ai/config.json",

  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "env": {
        "RUST_LOG": "error"
      },
      "initialization": {
        "rust-analyzer": {
          "procMacro": {
            "enable": false
          },
          "cachePriming": {
            "enable": false
          },
          "cargo": {
            "allTargets": false
          }
        }
      }
    }
  },

  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },

  "permission": {
    "external_directory": {
      "~/Dev/my_apps/Rust-LLM-Api-Router/src/infrastructure/provider/**": "allow"
    }
  },

  "tools": {
    "github_*": true,
    "context7_*": true,
    "skill": true,
    "mem_*": true
  },

  "instructions": [
    "When working on Rust projects, use context7 for documentation searches",
    "For GitHub operations, use the github MCP server tools",
    "Always check for existing code patterns before implementing new features",
    "Use rust-skills for comprehensive Rust best practices (invoke with /rust-skills)",
    "For API design with Actix-web, use @rust-api",
    "For code review, use @rust-reviewer",
    "For testing, use @rust-tester",
    "For project structure, use @rust-project",
    "For Spec-Driven Development, use @sdd-orchestrator or /sdd-* commands"
  ]
}
